<OPNsense>
  <IndProto>
    <general>
      <enabled>0</enabled>
      <default_action>pass</default_action>
      <interface>lan</interface>
    </general>
    <rules>
      <rule uuid="00000000-0000-0000-0000-000000000001">
        <enabled>1</enabled>
        <description>Allow Modbus reads from engineering workstation</description>
        <protocol>modbus</protocol>
        <src_ip>192.168.1.10</src_ip>
        <dst_ip>192.168.1.20</dst_ip>
        <dst_port>502</dst_port>
        <action>pass</action>
        <access>read</access>
        <function_codes></function_codes>
      </rule>
    </rules>
  </IndProto>
</OPNsense>
